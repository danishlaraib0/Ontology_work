  <mxGeometry x="85" y="1249" width="530" height="50" as="geometry"/>
</mxCell>
<mxCell id="cell_26" value="&lt;b&gt;⚙️ Graph Transformation &amp;amp; Ingestion Pipeline (loader.py)&lt;/b&gt;&lt;br/&gt;&lt;span style=&apos;font-size:10px;color:#166534;&apos;&gt;• Schema Constraints &amp;amp; Unique Indexes (Unique IDs for 23 labels)&lt;br/&gt;• Idempotent MERGE Cypher Operations (Lossless re-ingestion &amp;amp; historical preservation)&lt;br/&gt;• Non-destructive history (prevents overwriting historical sales and price changes)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=11;align=left;spacingLeft=12;shadow=1;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="715" y="190" width="590" height="85" as="geometry"/>
</mxCell>
<mxCell id="cell_27" value="&lt;div style=&apos;font-weight: 700; color: #14532D; font-size: 13px; text-align: center; margin-bottom: 6px;&apos;&gt;🕸️ Neo4j Typed Property Graph (23 Labels • 25 Relationships • 5 Domains)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#86EFAC;strokeWidth=1.5;verticalAlign=top;spacingTop=8;shadow=1;arcSize=6;" vertex="1" parent="1">
  <mxGeometry x="715" y="300" width="590" height="1050" as="geometry"/>
</mxCell>
<mxCell id="cell_28" value="&lt;b&gt;📦 1. PRODUCT &amp;amp; SPECIFICATION DOMAIN&lt;/b&gt;&lt;br/&gt;&lt;span style=&apos;font-size:10px;color:#334155;&apos;&gt;• &lt;b&gt;(:Brand)&lt;/b&gt; &lt;code&gt;-[:PRODUCES]-&gt;&lt;/code&gt; &lt;b&gt;(:VehicleModel)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;(:VehicleModel)&lt;/b&gt; &lt;code&gt;-[:HAS_GENERATION]-&gt;&lt;/code&gt; &lt;b&gt;(:Generation)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;(:VehicleModel)&lt;/b&gt; &lt;code&gt;-[:HAS_VARIANT]-&gt;&lt;/code&gt; &lt;b&gt;(:VehicleVariant)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;(:VehicleVariant)&lt;/b&gt; &lt;code&gt;-[:USES_ENGINE]-&gt;&lt;/code&gt; &lt;b&gt;(:Engine)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;(:VehicleVariant)&lt;/b&gt; &lt;code&gt;-[:HAS_FEATURE]-&gt;&lt;/code&gt; &lt;b&gt;(:Feature)&lt;/b&gt;&lt;br/&gt;• Node attributes: &lt;code&gt;ncap_rating&lt;/code&gt;, &lt;code&gt;boot_space&lt;/code&gt;, &lt;code&gt;airbags&lt;/code&gt;, &lt;code&gt;seating&lt;/code&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
  <mxGeometry x="735" y="345" width="550" height="150" as="geometry"/>
</mxCell>
<mxCell id="cell_29" value="&lt;b&gt;👥 2. CUSTOMER &amp;amp; BUYING PERSONA DOMAIN&lt;/b&gt;&lt;br/&gt;&lt;span style=&apos;font-size:10px;color:#334155;&apos;&gt;• &lt;b&gt;(:CustomerSegment)&lt;/b&gt; (Demographics, Income, Daily KM, Budget Band)&lt;br/&gt;• &lt;b&gt;(:CustomerSegment)&lt;/b&gt; &lt;code&gt;-[:PRIORITIZES {importance_weight}]-&gt;&lt;/code&gt; &lt;b&gt;(:BuyingFactor)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;(:CustomerSegment)&lt;/b&gt; &lt;code&gt;-[:CONSIDERS]-&gt;&lt;/code&gt; &lt;b&gt;(:VehicleModel)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;(:Feature)&lt;/b&gt; &lt;code&gt;-[:SATISFIES]-&gt;&lt;/code&gt; &lt;b&gt;(:Need)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
  <mxGeometry x="735" y="510" width="550" height="125" as="geometry"/>
</mxCell>
<mxCell id="cell_30" value="&lt;b&gt;🥊 3. COMPETITIVE BATTLEGROUND DYNAMICS&lt;/b&gt;&lt;br/&gt;&lt;span style=&apos;font-size:10px;color:#334155;&apos;&gt;• &lt;b&gt;(:VehicleModel)&lt;/b&gt; &lt;code&gt;-[:COMPETES_WITH {score, price_overlap, customer_overlap}]-&gt;&lt;/code&gt; &lt;b&gt;(:VehicleModel)&lt;/b&gt;&lt;br/&gt;• Traverses cross-shopping rivalry (Dzire ↔ Amaze ↔ Aura, Wagon R ↔ Tiago)&lt;br/&gt;• Exposes price overlap percentage &amp;amp; key battleground factors&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
  <mxGeometry x="735" y="650" width="550" height="115" as="geometry"/>
</mxCell>
<mxCell id="cell_31" value="&lt;b&gt;💬 4. OPINION, SENTIMENT &amp;amp; BEHAVIORAL DOMAIN&lt;/b&gt;&lt;br/&gt;&lt;span style=&apos;font-size:10px;color:#334155;&apos;&gt;• &lt;b&gt;(:Review)&lt;/b&gt; &lt;code&gt;-[:ABOUT]-&gt;&lt;/code&gt; &lt;b&gt;(:VehicleModel)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;(:Review)&lt;/b&gt; &lt;code&gt;-[:CONTAINS]-&gt;&lt;/code&gt; &lt;b&gt;(:Opinion)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;(:Opinion)&lt;/b&gt; &lt;code&gt;-[:ABOUT_ASPECT]-&gt;&lt;/code&gt; &lt;b&gt;(:Aspect)&lt;/b&gt; (Mileage, Safety, NVH, Space)&lt;br/&gt;• &lt;b&gt;(:SearchQuery)&lt;/b&gt; &lt;code&gt;-[:TARGETS]-&gt;&lt;/code&gt; &lt;b&gt;(:VehicleModel)&lt;/b&gt; &lt;code&gt;-[:HAS_INTENT]-&gt;&lt;/code&gt; &lt;b&gt;(:Intent)&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF4FF;strokeColor=#C026D3;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
  <mxGeometry x="735" y="780" width="550" height="135" as="geometry"/>
</mxCell>
<mxCell id="cell_32" value="&lt;b&gt;📊 5. COMMERCIAL OBSERVATION &amp;amp; PROVENANCE&lt;/b&gt;&lt;br/&gt;&lt;span style=&apos;font-size:10px;color:#334155;&apos;&gt;• &lt;b&gt;(:PriceObservation {valid_from, valid_to, ex_showroom_inr})&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;(:SalesObservation {period_value, units_sold, yoy_change_percent})&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;(:MarketChange)&lt;/b&gt; &lt;code&gt;&lt;-[:UNDERWENT_CHANGE]-&lt;/code&gt; &lt;b&gt;(:VehicleModel)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;(:Evidence)&lt;/b&gt; &lt;code&gt;-[:BACKS_CLAIM]-&gt;&lt;/code&gt; &lt;b&gt;(:Source)&lt;/b&gt; (Traceable audit trail)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
  <mxGeometry x="735" y="930" width="550" height="140" as="geometry"/>
</mxCell>
<mxCell id="cell_33" value="&lt;div style=&apos;text-align:center;&apos;&gt;&lt;b&gt;🟢 LIVE GRAPH INSTANCE (Docker Verified)&lt;/b&gt;&lt;br/&gt;&lt;span style=&apos;font-size:11px;color:#15803D;&apos;&gt;&lt;b&gt;700 Nodes&lt;/b&gt; &amp;nbsp;|&amp;nbsp; &lt;b&gt;2,029 Relationships&lt;/b&gt; &amp;nbsp;|&amp;nbsp; &lt;b&gt;21 Vehicle Models&lt;/b&gt; &amp;nbsp;|&amp;nbsp; &lt;b&gt;Port 7474 / 7687&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11;shadow=1;" vertex="1" parent="1">
  <mxGeometry x="735" y="1085" width="550" height="55" as="geometry"/>
</mxCell>
<mxCell id="cell_34" value="&lt;b&gt;📐 Graph Schema &amp;amp; Metamodel Registry (schema/metamodel.yaml)&lt;/b&gt;&lt;br/&gt;&lt;span style=&apos;font-size:10px;color:#334155;&apos;&gt;Provides allowed entity labels, relationship types, and properties to the Query Planner&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;shadow=1;" vertex="1" parent="1">
