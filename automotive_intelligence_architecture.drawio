</mxCell>
<mxCell id="cell_36" value="&lt;div style=&apos;font-weight: 700; color: #78350F; font-size: 13px; text-align: center; margin-bottom: 6px;&apos;&gt;⚡ Dual-Path Execution: Deterministic Tools &amp;amp; Validated Cypher&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FCD34D;strokeWidth=1.5;verticalAlign=top;spacingTop=8;shadow=1;arcSize=6;" vertex="1" parent="1">
